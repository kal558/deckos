[Unit]
Description=Valhalla offline routing (this deck only)
After=deck.mount
BindsTo=deck.mount
ConditionPathExists=/deck/library/valhalla/valhalla_tiles.tar

[Service]
User=deck
Group=deck
RuntimeDirectory=valhalla
ExecStart=/usr/bin/valhalla_service /etc/valhalla/valhalla.json 1
Restart=on-failure
RestartSec=10
Nice=10
MemoryHigh=400M
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target deck.mount

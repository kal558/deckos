<?xml version="1.0" encoding="UTF-8"?>
<!-- deckOS LibreOffice lockdown: no update checks, no crash reports, no online
     features, macros disabled, UK English, documents saved to the encrypted folder. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Jobs" oor:package="org.openoffice.Office">
    <node oor:name="Jobs">
      <node oor:name="UpdateCheck" oor:op="fuse">
        <node oor:name="Arguments">
          <prop oor:name="AutoCheckEnabled" oor:op="fuse" oor:finalized="true"><value>false</value></prop>
          <prop oor:name="AutoDownloadEnabled" oor:op="fuse" oor:finalized="true"><value>false</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <prop oor:name="MacroSecurityLevel" oor:op="fuse" oor:finalized="true"><value>3</value></prop>
        <prop oor:name="DisableMacrosExecution" oor:op="fuse" oor:finalized="true"><value>true</value></prop>
        <prop oor:name="BlockUntrustedRefererLinks" oor:op="fuse"><value>true</value></prop>
      </node>
    </node>
    <node oor:name="Misc">
      <prop oor:name="CrashReport" oor:op="fuse" oor:finalized="true"><value>false</value></prop>
      <prop oor:name="CollectUsageInformation" oor:op="fuse" oor:finalized="true"><value>false</value></prop>
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
      <prop oor:name="FirstRun" oor:op="fuse"><value>false</value></prop>
    </node>
    <node oor:name="Path">
      <node oor:name="Current">
        <prop oor:name="Work" oor:op="fuse"><value>file:///deck/personal/documents</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Linguistic" oor:package="org.openoffice.Office">
    <node oor:name="General">
      <prop oor:name="DefaultLocale" oor:op="fuse"><value>en-GB</value></prop>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="L10N">
      <prop oor:name="ooLocale" oor:op="fuse"><value>en-GB</value></prop>
      <prop oor:name="ooSetupSystemLocale" oor:op="fuse"><value>en-GB</value></prop>
    </node>
    <node oor:name="Office">
      <prop oor:name="ooSetupInstCompleted" oor:op="fuse"><value>true</value></prop>
    </node>
  </oor:component-data>
</oor:data>

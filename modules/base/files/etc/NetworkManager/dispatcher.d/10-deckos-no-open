#!/bin/sh
# Never let an open (unencrypted) Wi-Fi network auto-connect: after the user has
# connected to one deliberately, switch its autoconnect off.
[ "$2" = "up" ] || exit 0
[ -n "$CONNECTION_UUID" ] || exit 0
sec=$(nmcli -g 802-11-wireless-security.key-mgmt connection show "$CONNECTION_UUID" 2>/dev/null)
type=$(nmcli -g connection.type connection show "$CONNECTION_UUID" 2>/dev/null)
if [ "$type" = "802-11-wireless" ] && [ -z "$sec" ]; then
  nmcli connection modify "$CONNECTION_UUID" connection.autoconnect no
fi
exit 0
